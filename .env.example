DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_target_server_guild_id_here

# Authentification Discord OAuth2 pour le dashboard web
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Port du dashboard web (sur Pterodactyl/Pelican, SERVER_PORT est automatiquement utilisé si PORT n'est pas un nombre)
PORT=3000
SESSION_SECRET=a_very_secret_key_here
# Sécurité des cookies : 0 en HTTP direct (IP:PORT), 1 en production avec reverse proxy HTTPS / SSL
COOKIE_SECURE=0
NODE_ENV=development
